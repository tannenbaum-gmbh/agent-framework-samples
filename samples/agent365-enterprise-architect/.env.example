# Microsoft Entra tenant that owns the agent identity blueprint.
AZURE_TENANT_ID=
# Optional: public client used for delegated Graph sign-in in app.manage_identity.
# Defaults to Microsoft Graph PowerShell (14d82eec-204b-4c2f-b7e8-296a70dab67e).
GRAPH_CLIENT_ID=

# Outputs of `python -m app.manage_identity blueprint create` and `identity create`.
AGENT_BLUEPRINT_APP_ID=
AGENT_IDENTITY_ID=
AGENT_IDENTITY_CLIENT_ID=
# Optional: user object ID of the sponsor. Required for `identity create --auth blueprint`.
AGENT_SPONSOR_ID=

# Optional blueprint credential for local management commands only; never uploaded.
AGENT_BLUEPRINT_CLIENT_SECRET=
# Leave empty for the sandbox group's system-assigned managed identity.
# For a user-assigned identity, set its CLIENT ID (not principal/object ID).
# The identity must be attached to the group and trusted by the blueprint.
AGENT_BLUEPRINT_MANAGED_IDENTITY_CLIENT_ID=

# Microsoft Foundry project settings (outputs from the infra deployment).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.3-codex-2
WORKIQ_CONNECTION_NAME=workshop-workiq-mcp

# Azure Container Apps sandbox group settings.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_SANDBOX_GROUP=
AZURE_SANDBOX_REGION=
SANDBOX_DISK_IMAGE=python-3.14

# Optional Agent 365 Activity export; requires registration and sponsor attribution.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
# Opt in only when prompts/answers are approved for telemetry storage.
A365_CAPTURE_CONTENT=false
A365_SPONSOR_ID=
A365_SPONSOR_NAME=
A365_SPONSOR_EMAIL=

# Observability verbose logging.
OTEL_LOG_LEVEL=INFO
A365_OBSERVABILITY_LOG_LEVEL="info|warn|error"
