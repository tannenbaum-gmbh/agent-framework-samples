# Existing resources; this sample does not provision Azure infrastructure.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
AZURE_STORAGE_RESOURCE_ID=/subscriptions/YOUR-SUBSCRIPTION/resourceGroups/YOUR-RG/providers/Microsoft.Storage/storageAccounts/YOUR-STORAGE
# Resource endpoint, not a Foundry project endpoint or /openai/v1 URL.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Only needed for app.invoke without --search-only.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
# Dedicated names for this sample. Do not point at production search objects.
AZURE_SEARCH_RESOURCE_PREFIX=classic-rag
