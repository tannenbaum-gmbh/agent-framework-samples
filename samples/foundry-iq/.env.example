# Reuse the Search service and index created by ../ai-search-rag.
AZURE_SEARCH_ENDPOINT=https://my-search.search.windows.net
AZURE_SEARCH_RESOURCE_PREFIX=classic-rag
# Optional explicit override: AZURE_SEARCH_INDEX_NAME=classic-rag-chunks

FOUNDRY_PROJECT_ENDPOINT=https://my-foundry.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/SUBSCRIPTION_ID/resourceGroups/RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/my-foundry/projects/my-project
AZURE_OPENAI_ENDPOINT=https://my-foundry.openai.azure.com
FOUNDRY_MODEL_DEPLOYMENT=gpt-5
# Actual underlying model name, which can differ from the deployment name.
FOUNDRY_MODEL_NAME=gpt-5
# Dedicated names for the new objects, independent of the existing index prefix.
FOUNDRY_IQ_RESOURCE_PREFIX=foundry-iq
