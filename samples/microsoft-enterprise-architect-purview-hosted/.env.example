FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.3-codex-2
# Existing Work IQ MCP connection in this project; no secrets or tokens here.
WORKIQ_CONNECTION_NAME=workshop-workiq-mcp
# app.deploy resolves the connection ID and passes it to the hosted runtime.

# Non-secret Purview policy scope and trusted single-user workshop identity.
PURVIEW_TENANT_ID=YOUR-TENANT-UUID
PURVIEW_APP_ID=YOUR-POLICY-APPLICATION-CLIENT-UUID
PURVIEW_USER_ID=YOUR-WORKSHOP-USER-OBJECT-UUID
# The runtime's managed identity needs admin-consented Graph application roles.
# No client secrets or access tokens belong in this file or the deployment ZIP.
