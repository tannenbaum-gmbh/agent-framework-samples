# Copy to .env and fill in the values produced by the infra/ deployment, then
# `export $(grep -v '^#' .env | xargs)` or use `python-dotenv`/your shell's .env support.
# Agent Framework does not load .env files automatically.

# The AI Foundry project endpoint (infra output: foundryProjectEndpoint), e.g.
# https://aif-<env>.services.ai.azure.com/api/projects/proj-<env>
FOUNDRY_PROJECT_ENDPOINT=

# The GPT-5 model deployment name (infra output: gpt5DeploymentName). Defaults to "gpt-5".
FOUNDRY_MODEL_DEPLOYMENT=gpt-5

# Subscription that holds the Container Apps sandbox group (`az account show --query id -o tsv`).
AZURE_SUBSCRIPTION_ID=

# Resource group that holds the sandbox group (infra output: resourceGroupName).
AZURE_RESOURCE_GROUP=

# Name of the Microsoft.App/sandboxGroups resource (infra output: sandboxGroupName).
AZURE_SANDBOX_GROUP=

# Region of the sandbox group (infra output: sandboxGroupLocation), e.g. westus2.
AZURE_SANDBOX_REGION=

# Public disk image used for new sandboxes. Defaults to "python-3.14".
SANDBOX_DISK_IMAGE=python-3.14
