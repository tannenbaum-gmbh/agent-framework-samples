# Microsoft Foundry project settings (outputs from the infra deployment).
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT=gpt-5

# Azure Container Apps sandbox group settings.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_SANDBOX_GROUP=
AZURE_SANDBOX_REGION=
SANDBOX_DISK_IMAGE=python-3.14

# Optional: comma-separated source CIDRs allowed to reach the endpoint, e.g. 203.0.113.7/32.
# Leave empty to accept any source IP (the API key is still required).
SANDBOX_ALLOWED_CIDRS=
# Optional: idle seconds before the sandbox auto-suspends (default 3600).
SANDBOX_IDLE_SUSPEND_SECONDS=3600
